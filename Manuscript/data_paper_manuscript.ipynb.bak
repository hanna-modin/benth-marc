   "outputs": [
    {
     "data": {
      "text/markdown": [
       "Visualizing the distribution of records over depth provides an even clearer picture of the decreasing sampling effort with depth. The vast majority of sampling has occurred at shallow depths (@fig-depth), with 50% of the records being sampled at a depth of less than 265 meters, and only 39% being sampled at a depth greater than 300 meters. Approximately 97% of the records come from sampling conducted in the top 1000 meters. Due to incomplete coverage in the depth column, extracted depth values from GEBCO's gridded bathymetry data [@gebco2025] were used in the graph. "
      ],
      "text/plain": [
       "<IPython.core.display.Markdown object>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "display(Markdown(\n",
    "    f\"Visualizing the distribution of records over depth provides an even clearer picture of the decreasing sampling effort with depth. The vast majority of sampling has occurred at shallow depths (@fig-depth), \" \n",
    "    f\"with 50% of the records being sampled at a depth of less than {median_depth_m:.0f} meters, and only {pct_over_300:.0f}% being sampled at a \"\n",
    "    f\"depth greater than 300 meters. Approximately {pct_in_0_1000:.0f}% of the records come from sampling conducted in the top 1000 meters. Due to incomplete coverage in the depth column, extracted depth values from \"\n",
    "    f\"GEBCO's gridded bathymetry data [@gebco2025] were used in the graph. \" \n",
    "))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 55,
   "id": "2468af0d-a56c-4e3a-b64a-ab5c5ec67c2d",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x400 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "#| fig-pos: \"H\"\n",
    "#| label: fig-depth\n",
    "#| fig-cap: \"Number of records of benthic invertebrates over depth range in the BENTH-MARC database. Note the different scales in the split x axis.\"\n",
    "\n",
    "\n",
    "# Load data\n",
    "df_depth = pd.read_parquet('Final/merged_all_final.parquet')\n",
    "bathy_abs = df_depth['gebcoDepth'].dropna().abs()\n",
    "# Build 100 m bins across full observed range\n",
    "bin_width = 100\n",
    "max_depth_full = int(np.ceil(bathy_abs.max() / bin_width) * bin_width)\n",
    "edges_full = np.arange(0, max_depth_full + bin_width, bin_width)\n",
    "labels_full = [str(i) + ' to ' + str(i + bin_width) + ' m' for i in range(0, max_depth_full, bin_width)]\n",
    "binned_full = pd.cut(bathy_abs, bins=edges_full, right=True, include_lowest=True, labels=labels_full)\n",
    "counts_full = binned_full.value_counts(sort=False).reset_index()\n",
    "counts_full.columns = ['bin_label', 'records']\n",
    "counts_full['bin_start'] = counts_full['bin_label'].apply(lambda s: int(str(s).split(' to ')[0]))\n",
    "counts_full = counts_full.sort_values('bin_start').reset_index(drop=True)\n",
    "# Filter bins to exclude depths greater than 6000 meters\n",
    "counts_full = counts_full[counts_full['bin_start'] <= 6000].reset_index(drop=True)\n",
    "# Create y-tick positions and labels\n",
    "ytick_positions = np.arange(len(counts_full))\n",
    "ytick_labels = []\n",
    "for _, row in counts_full.iterrows():\n",
    "    start_val = int(str(row['bin_label']).split(' to ')[0].replace(' m', ''))\n",
    "    if start_val % 500 == 0:\n",
    "        ytick_labels.append(str(start_val) + ' m')\n",
    "    else:\n",
    "        ytick_labels.append('')\n",
    "# Build the two-panel broken x-axis barplot with data-driven x-axis break\n",
    "max_records = float(counts_full['records'].max())\n",
    "p90_records = float(counts_full['records'].quantile(0.90))\n",
    "x_break = int(np.ceil(p90_records / 500.0) * 500)\n",
    "x_break = max(1000, min(x_break, int(np.floor(max_records * 0.85))))\n",
    "if x_break <= 0:\n",
    "    x_break = 1000\n",
    "right_mask = counts_full['records'] > x_break\n",
    "if not right_mask.any():\n",
    "    x_break = int(max(500, np.floor(max_records * 0.8)))\n",
    "    right_mask = counts_full['records'] > x_break\n",
    "right_xlim_max = int(np.ceil(max_records / 500.0) * 500) if max_records > 0 else x_break + 500\n",
    "fig, (ax1, ax2) = plt.subplots(ncols=2, sharey=True, figsize=(10, 4), gridspec_kw={'width_ratios': [2, 1]})\n",
    "# Left panel (0..x_break)\n",
    "sns.barplot(data=counts_full, y='bin_label', x='records', color='#9DC8D2', orient='h', errorbar=None, ax=ax1)\n",
    "ax1.set_xlim(0, x_break)\n",
    "# Right panel (>x_break)\n",
    "sns.barplot(data=counts_full[right_mask], y='bin_label', x='records', color='#9DC8D2', orient='h', errorbar=None, ax=ax2)\n",
    "ax2.set_xlim(x_break, right_xlim_max)\n",
    "# Apply y ticks/labels to both panels\n",
    "ax1.set_yticks(ytick_positions)\n",
    "ax1.set_yticklabels(ytick_labels)\n",
    "ax2.set_yticks(ytick_positions)\n",
    "ax2.set_yticklabels(ytick_labels)\n",
    "# Format x-axis ticks for readability\n",
    "ax1.xaxis.set_major_locator(MaxNLocator(nbins=5, integer=True, prune='both'))\n",
    "ax1.xaxis.set_major_formatter(FuncFormatter(lambda x, pos: f'{int(x):,}'))\n",
    "ax2.xaxis.set_major_locator(MaxNLocator(nbins=3, integer=True, prune='both'))\n",
    "ax2.xaxis.set_major_formatter(FuncFormatter(lambda x, pos: f'{int(x):,}'))\n",
    "ax2.tick_params(axis='x', labelsize=9)\n",
    "# Diagonal break markers\n",
    "d = 0.008\n",
    "kwargs = dict(transform=ax1.transAxes, color='k', clip_on=False, linewidth=0.8)\n",
    "ax1.plot((1 - d, 1 + d), (-d, +d), **kwargs)\n",
    "ax1.plot((1 - d, 1 + d), (1 - d, 1 + d), **kwargs)\n",
    "kwargs.update(transform=ax2.transAxes)\n",
    "ax2.plot((-d, +d), (-d, +d), **kwargs)\n",
    "ax2.plot((-d, +d), (1 - d, 1 + d), **kwargs)\n",
    "# Style\n",
    "for ax in (ax1, ax2):\n",
    "    ax.set_xlabel('Number of records')\n",
    "    ax.set_ylabel('')\n",
    "    ax.grid(axis='x', linestyle='--', linewidth=0.4, alpha=0.5, zorder=0)\n",
    "plt.tight_layout()\n",
    "out_path = 'Figures/depth.png'\n",
    "plt.savefig(out_path, dpi=300)\n",
    "plt.show()"
   ]
  },
