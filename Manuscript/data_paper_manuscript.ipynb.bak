   "outputs": [],
   "source": [
    "# Load and process data for the map (Number of records per station)\n",
    "station_counts_path = 'Final/all_stations.parquet'\n",
    "df_taxa = pd.read_parquet(station_counts_path)\n",
    "\n",
    "# Validate required records column\n",
    "if 'uniqueAphiaIDCount' not in df_taxa.columns:\n",
    "    raise KeyError(\"Column 'uniqueAphiaIDCount' not found in Final/all_stations.parquet\")\n",
    "\n",
    "# Shared station definition used in the manuscript, year and startDayOfYear optional\n",
    "station_cols_full = ['datasetKey', 'decimalLatitudeStart', 'decimalLongitudeStart', 'year', 'startDayOfYear']\n",
    "station_cols_required = ['datasetKey', 'decimalLatitudeStart', 'decimalLongitudeStart']\n",
    "\n",
    "\n",
    "def apply_station_definition(df, value_cols):\n",
    "    \"\"\"Apply station-level de-duplication; keep rows with missing optional fields.\"\"\"\n",
    "    if set(station_cols_required).issubset(df.columns):\n",
    "        out = df.copy()\n",
    "        out['decimalLatitudeStart'] = pd.to_numeric(out['decimalLatitudeStart'], errors='coerce')\n",
    "        out['decimalLongitudeStart'] = pd.to_numeric(out['decimalLongitudeStart'], errors='coerce')\n",
    "\n",
    "        if 'year' in out.columns:\n",
    "            out['year'] = pd.to_numeric(out['year'], errors='coerce').round().astype('Int64')\n",
    "\n",
    "        if 'startDayOfYear' in out.columns:\n",
    "            out['startDayOfYear'] = pd.to_numeric(out['startDayOfYear'], errors='coerce').astype('Int64')\n",
    "\n",
    "        # Do NOT drop rows missing optional fields; keep them as NaN/Int64\n",
    "        dedupe_cols = station_cols_required + ([ 'year' ] if 'year' in out.columns else []) + ([ 'startDayOfYear' ] if 'startDayOfYear' in out.columns else [])\n",
    "        keep_cols = dedupe_cols + [c for c in value_cols if c in out.columns]\n",
    "        return out[keep_cols].drop_duplicates(dedupe_cols)\n",
    "\n",
    "    return df.copy()\n",
    "\n",
    "\n",
    "# Apply station definition for taxa map when station columns are available\n",
    "df_taxa = apply_station_definition(df_taxa, value_cols=['uniqueAphiaIDCount'])\n",
    "\n",
    "# Standardize coordinate column names for downstream plotting\n",
    "lon_candidates = ['decimalLongitudeStart', 'LonStart', 'decimalLongitude', 'lon', 'longitude']\n",
    "lat_candidates = ['decimalLatitudeStart', 'LatStart', 'decimalLatitude', 'lat', 'latitude']\n",
    "\n",
    "lon_col = next((c for c in lon_candidates if c in df_taxa.columns), None)\n",
    "lat_col = next((c for c in lat_candidates if c in df_taxa.columns), None)\n",
    "\n",
    "if lon_col is None or lat_col is None:\n",
    "    raise KeyError(\"Could not find station longitude/latitude columns in Final/all_stations.parquet\")\n",
    "\n",
    "plot_df_taxa = (\n",
    "    df_taxa.rename(columns={lon_col: 'lon', lat_col: 'lat'})\n",
    "          .copy()\n",
    ")\n",
    "plot_df_taxa['lon'] = pd.to_numeric(plot_df_taxa['lon'], errors='coerce')\n",
    "plot_df_taxa['lat'] = pd.to_numeric(plot_df_taxa['lat'], errors='coerce')\n",
    "plot_df_taxa['uniqueAphiaIDCount'] = pd.to_numeric(plot_df_taxa['uniqueAphiaIDCount'], errors='coerce')\n",
    "plot_df_taxa = plot_df_taxa.dropna(subset=['lon', 'lat', 'uniqueAphiaIDCount'])\n",
    "plot_df_taxa = plot_df_taxa[\n",
    "    (plot_df_taxa['lat'] >= -90) & (plot_df_taxa['lat'] <= 90) &\n",
    "    (plot_df_taxa['lon'] >= -180) & (plot_df_taxa['lon'] <= 180)\n",
    "]\n",
    "plot_df_taxa = plot_df_taxa.sort_values('uniqueAphiaIDCount', ascending=True)\n",
    "\n",
    "# Load and process data for binary gear-information map (station level)\n",
    "stations_gear_path = 'Final/all_stations.parquet'\n",
    "df_gear_station = pd.read_parquet(stations_gear_path)\n",
    "\n",
    "# Apply the same station definition for station-level gear data (year and startDayOfYear can be missing)\n",
    "df_gear_station = apply_station_definition(df_gear_station, value_cols=['gear'])\n",
    "\n",
    "lon_col_gear = next((c for c in lon_candidates if c in df_gear_station.columns), None)\n",
    "lat_col_gear = next((c for c in lat_candidates if c in df_gear_station.columns), None)\n",
    "\n",
    "if lon_col_gear is None or lat_col_gear is None:\n",
    "    raise KeyError(\"Could not find station longitude/latitude columns in Final/all_stations.parquet\")\n",
    "if 'gear' not in df_gear_station.columns:\n",
    "    raise KeyError(\"Column 'gear' not found in Final/all_stations.parquet\")\n",
    "\n",
    "coords_gear = df_gear_station.rename(columns={lon_col_gear: 'lon', lat_col_gear: 'lat'})[['lon', 'lat', 'gear']].copy()\n",
    "coords_gear['lon'] = pd.to_numeric(coords_gear['lon'], errors='coerce')\n",
    "coords_gear['lat'] = pd.to_numeric(coords_gear['lat'], errors='coerce')\n",
    "\n",
    "gear_norm = coords_gear['gear'].astype('string').str.strip().str.lower()\n",
    "missing_tokens = {'', 'nan', 'none', '<na>'}\n",
    "coords_gear['gear_info'] = np.where(\n",
    "    coords_gear['gear'].isna() | gear_norm.isin(missing_tokens),\n",
    "    'No gear info',\n",
    "    'With gear info'\n",
    ")\n",
    "\n",
    "coords_gear = coords_gear.dropna(subset=['lon', 'lat'])\n",
    "coords_gear = coords_gear[\n",
    "    (coords_gear['lat'] >= -90) & (coords_gear['lat'] <= 90) &\n",
    "    (coords_gear['lon'] >= -180) & (coords_gear['lon'] <= 180)\n",
    "]\n",
    "\n",
    "colors_gear = {'No gear info': '#9DC8D2', 'With gear info': '#2C3E50'}\n",
    "drawing_order_gear = ['No gear info', 'With gear info']\n",
    "\n",
    "# Prepare data for the gear information bar plot (record level)\n",
    "df_merged_gear = pd.read_parquet('Final/merged_all_final.parquet', columns=['gear'])\n",
    "\n",
    "gear_series = df_merged_gear['gear']\n",
    "has_gear_info = gear_series.notna()\n",
    "no_gear_info = gear_series.isna()\n",
    "\n",
    "n_records = len(gear_series)\n",
    "pct_with_gear = (float(has_gear_info.sum()) / float(n_records) * 100.0) if n_records > 0 else 0.0\n",
    "pct_without_gear = (float(no_gear_info.sum()) / float(n_records) * 100.0) if n_records > 0 else 0.0\n",
    "\n",
    "plot_df_gear = pd.DataFrame({\n",
    "    'Gear info': ['With gear info', 'No gear info'],\n",
    "    'Percent': [pct_with_gear, pct_without_gear]\n",
    "})\n",
    "order_gear = ['With gear info', 'No gear info']\n",
    "color_map_gear = {'With gear info': '#2C3E50', 'No gear info': '#9DC8D2'}\n"
   ]
  },
