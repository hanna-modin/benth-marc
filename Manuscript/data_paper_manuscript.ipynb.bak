    "#| fig-pos: \"H\"\n",
    "#| fig-subcap: []\n",
    "#| fig-names: false\n",
    "\n",
    "# Create a figure with a custom grid layout\n",
    "fig = plt.figure(figsize=(12, 10))\n",
    "gs = gridspec.GridSpec(\n",
    "    2, 2,  # 2 rows, 2 columns\n",
    "    width_ratios=[1, 1],  # Adjust the width of each column\n",
    "    height_ratios=[2, 0.1]  # Adjust the height of each row\n",
    ")\n",
    "# Plot 1: Biomass Coverage Map \n",
    "ax1 = fig.add_subplot(gs[0, 0], projection=ccrs.NorthPolarStereo())\n",
    "ax1.set_extent([-180, 180, 50, 90], crs=ccrs.PlateCarree())\n",
    "ax1.add_feature(cfeature.LAND, facecolor='whitesmoke')\n",
    "ax1.add_feature(cfeature.OCEAN, facecolor='aliceblue')\n",
    "ax1.coastlines(resolution='10m', linewidth=0.2, color='black')\n",
    "ax1.gridlines(draw_labels=False, linewidth=0.3, color='gray', alpha=0.5, linestyle='--')\n",
    "for coverage_type in drawing_order_biomass:\n",
    "    subset = coords_biomass[coords_biomass['biomass_coverage'] == coverage_type]\n",
    "    ax1.scatter(subset['lon'].values, subset['lat'].values,\n",
    "                s=1, color=coverage_colors[coverage_type], alpha=0.6,\n",
    "                label=coverage_type.capitalize(), transform=ccrs.PlateCarree())\n",
    "legend_handles_biomass_map = [\n",
    "    mpl.lines.Line2D([0], [0], marker='o', linestyle='None',\n",
    "                     markerfacecolor=coverage_colors[k], markeredgecolor=coverage_colors[k],\n",
    "                     markersize=5, label=k.capitalize())\n",
    "    for k in drawing_order_biomass\n",
    "]\n",
    "ax1.legend(handles=legend_handles_biomass_map, loc='upper center', bbox_to_anchor=(0.5, 1.07), fontsize=12, ncol=3, frameon=False)\n",
    "ax1.set_title('Biomass coverage across stations', pad=22, fontsize=14)\n",
    "ax1.text(0.02, 0.98, 'a)', transform=ax1.transAxes, ha='left', va='top', fontsize=14, fontweight='bold', zorder=10)\n",
    "\n",
    "# Plot 2: Sampling Metrics Map (Top-right, larger height)\n",
    "ax2 = fig.add_subplot(gs[0, 1], projection=ccrs.NorthPolarStereo())\n",
    "ax2.set_extent([-180, 180, 50, 90], crs=ccrs.PlateCarree())\n",
    "ax2.add_feature(cfeature.LAND, facecolor='whitesmoke')\n",
