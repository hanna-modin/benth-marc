   "cell_type": "code",
   "execution_count": 45,
   "id": "ad25694b-5f3d-4204-b23a-3aab4f20f07e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calculate percentages of records on shelves, in abyss/hadal, and outside geomorphological categories\n",
    "\n",
    "df_geo = pd.read_parquet('Final/merged_all_final.parquet')\n",
    "\n",
    "# Ensure 'geomorphologicalCategory' column exists\n",
    "if 'geomorphologicalCategory' not in df_geo.columns:\n",
    "    raise KeyError(\"The column 'geomorphologicalCategory' is missing from the dataset.\")\n",
    "\n",
    "# Normalize category text to avoid mismatches from spacing/case and naming variants\n",
    "df_geo['geomorphologicalCategory_clean'] = df_geo['geomorphologicalCategory'].astype(str).str.strip()\n",
    "\n",
    "# Define shelf categories and flag rows that are on shelves\n",
    "shelf_levels = {'Shallow shelf', 'Medium shelf', 'Deep shelf'}\n",
    "df_geo['is_shelf'] = df_geo['geomorphologicalCategory_clean'].isin(shelf_levels)\n",
    "\n",
    "# Flag abyssal/hadal records using exact names plus robust keyword matching\n",
    "abyss_levels = {\n",
    "    'Abyssal plains',\n",
    "    'Abyssal mountains',\n",
    "    'Abyssal hills',\n",
    "    'Hadal',\n",
    "    'Abyssal mountains and hills',\n",
    "    'Abyssal plains and hadal zones',\n",
    "}\n",
    "df_geo['is_abyssal'] = (\n",
    "    df_geo['geomorphologicalCategory_clean'].isin(abyss_levels)\n",
    "    | df_geo['geomorphologicalCategory_clean'].str.contains(r'abyssal|hadal', case=False, na=False)\n",
    ")\n",
    "\n",
    "# Compute counts and percentages\n",
    "total_count_geo = int(len(df_geo))\n",
    "\n",
    "shelf_count = int(df_geo['is_shelf'].sum())\n",
    "shelf_pct = (shelf_count / total_count_geo) * 100 if total_count_geo > 0 else float('nan')\n",
    "\n",
    "abyssal_count = int(df_geo['is_abyssal'].sum())\n",
    "abyssal_pct = (abyssal_count / total_count_geo) * 100 if total_count_geo > 0 else float('nan')\n",
    "\n",
    "# Outside geomorphological categories = missing/blank placeholder category entries\n",
    "outside_missing_tokens = {'', 'nan', 'none', '<na>', 'na'}\n",
    "outside_mask = df_geo['geomorphologicalCategory'].isna() | df_geo['geomorphologicalCategory_clean'].str.lower().isin(outside_missing_tokens)\n",
    "outside_count = int(outside_mask.sum())\n",
    "outside_pct = (outside_count / total_count_geo) * 100 if total_count_geo > 0 else float('nan')\n",
    "\n",
    "formatted_percentage_shelf_pct = f\"{shelf_pct:.0f}\"\n",
    "formatted_percentage_abyssal_pct = f\"{abyssal_pct:.0f}\"\n",
    "formatted_percentage_outside_pct = f\"{outside_pct:.0f}\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 46,
   "id": "80373bba-0a93-49ad-a49b-e52936a2d632",
   "metadata": {},
   "outputs": [],
   "source": [
    "#| include: false\n",
    "\n",
    "# Load the dataset\n",
    "df_geo = pd.read_parquet('Final/merged_all_final.parquet')\n",
    "\n",
    "# Define the taxon column\n",
    "taxon_col = 'acceptedScientificName'\n",
    "if taxon_col not in df_geo.columns:\n",
    "    possible = [c for c in df_geo.columns if 'ScientificName' in c]\n",
    "    taxon_col = possible[0] if len(possible) > 0 else df_geo.columns[-1]\n",
    "\n",
    "# Clean and normalize the geomorphology category\n",
    "df_geo['geomorphologicalCategory_clean'] = df_geo['geomorphologicalCategory'].astype(str).str.strip()\n",
    "\n",
    "# Group by category and compute summary statistics\n",
    "grp = df_geo.groupby('geomorphologicalCategory_clean', dropna=False)\n",
    "summary = grp.agg(\n",
    "    records=('geomorphologicalCategory_clean', 'size'),\n",
    "    unique_taxa=(taxon_col, pd.Series.nunique),\n",
    ").reset_index()\n",
    "\n",
    "# Compute total records and unique taxa (same basis as before)\n",
    "total_records_geo = int(summary['records'].sum())\n",
    "total_unique_taxa = int(summary['unique_taxa'].sum())\n",
    "\n",
    "# Compute proportions\n",
    "summary['prop_records'] = summary['records'] / total_records_geo\n",
    "summary['prop_unique_taxa'] = summary['unique_taxa'] / total_unique_taxa\n",
    "\n",
    "# Safe inverses (avoid division by zero)\n",
    "prop_records_safe = summary['prop_records'].replace(0, np.nan)\n",
    "prop_unique_safe = summary['prop_unique_taxa'].replace(0, np.nan)\n",
    "\n",
    "# Compute ratios\n",
    "summary['records_to_taxa_ratio'] = prop_records_safe / prop_unique_safe\n",
    "summary['taxa_to_records_ratio'] = prop_unique_safe / prop_records_safe\n",
    "\n",
    "# Deep shelf ratio from exact category\n",
    "deep_mask = summary['geomorphologicalCategory_clean'].eq('Deep shelf')\n",
    "deep_shelf_ratio = summary.loc[deep_mask, 'taxa_to_records_ratio'].iloc[0] if deep_mask.any() else None\n",
    "\n",
    "# Abyssal plains and hadal zones ratio from exact category\n",
    "abyss_mask = summary['geomorphologicalCategory_clean'].eq('Abyssal plains and hadal zones')\n",
    "abyssal_plains_hadal_ratio = summary.loc[abyss_mask, 'taxa_to_records_ratio'].iloc[0] if abyss_mask.any() else None\n",
    "\n",
    "# Backward-compatible aliases used elsewhere in the notebook\n",
    "shallow_shelf_ratio = deep_shelf_ratio\n",
    "abyssal_plains_ratio = abyssal_plains_hadal_ratio"
   ]
  },
