    "                label=cat.capitalize(), transform=ccrs.PlateCarree())\n",
    "legend_handles_metric_map = [\n",
    "    mpl.lines.Line2D([0], [0], marker='o', linestyle='None',\n",
    "                     markerfacecolor=colors_metric[k], markeredgecolor=colors_metric[k],\n",
    "                     markersize=5, label=k)\n",
    "    for k in drawing_order_metric\n",
    "]\n",
    "ax2.legend(handles=legend_handles_metric_map, loc='upper center', bbox_to_anchor=(0.5, 1.07), fontsize=12, ncol=3, frameon=False, columnspacing=1)\n",
    "ax2.set_title('Occurrence metrics across stations', pad=22, fontsize=14)\n",
    "ax2.text(0.02, 0.98, 'b)', transform=ax2.transAxes, ha='left', va='top', fontsize=14, fontweight='bold', zorder=10)\n",
    "\n",
    "# Use the original two-category barplot order and colors\n",
    "order_metrics = ['Presence', 'Abundance']\n",
    "color_map_metrics = {'Presence': '#9DC8D2', 'Abundance': '#2C3E50'}\n",
    "\n",
    "# Plot 3: Biomass Records Bar Plot (Bottom-left, smaller height)\n",
    "ax3 = fig.add_subplot(gs[1, 0])\n",
    "left_val = 0.0\n",
    "for i, count in enumerate(counts_biomass):\n",
    "    bar_color = colors_biomass[i]\n",
    "    ax3.barh([0], [count], left=left_val, color=bar_color, edgecolor='none', linewidth=0)\n",
    "    pct = 0 if total_obs == 0 else count / total_obs * 100.0\n",
    "    x_mid = left_val + count / 2.0\n",
    "    # Determine text color based on bar color brightness\n",
    "    rgb = mcolors.to_rgb(bar_color)\n",
    "    brightness = rgb_to_hsv(rgb)[2]  # Get the value (brightness) from HSV\n",
    "    text_color = 'white' if brightness < 0.5 else 'black'\n",
    "    ax3.text(x_mid, 0, f'{pct:.0f}%', ha='center', va='center', fontsize=14, color=text_color)\n",
    "    left_val += count\n",
    "# Add small white gaps between segments\n",
    "gap_left = 0.0\n",
    "for count in counts_biomass[:-1]:\n",
    "    gap_left += count\n",
    "    ax3.vlines(gap_left, -0.4, 0.4, colors='white', linewidth=2)\n",
    "# Style for Plot 3\n",
    "ax3.set_xticks([])\n",
    "ax3.set_yticks([])\n",
    "ax3.set_title('Biomass coverage across records', pad=20, fontsize=14)\n",
    "ax3.spines['top'].set_visible(False)\n",
    "ax3.spines['right'].set_visible(False)\n",
    "ax3.spines['left'].set_visible(False)\n",
    "ax3.spines['bottom'].set_visible(False)\n",
    "ax3.grid(False)\n",
    "# Add legend for Plot 3\n",
    "legend_handles = [Patch(facecolor=colors_biomass[i], edgecolor='none', label=labels_biomass[i]) for i in range(len(labels_biomass))]\n",
    "ax3.legend(\n",
    "    handles=legend_handles,\n",
    "    loc='upper center',\n",
    "    bbox_to_anchor=(0.5, 1.6),  # Position the legend below the plot\n",
    "    ncol=2,  # Number of columns in the legend\n",
    "    frameon=False,  # Remove the legend box\n",
    "    fontsize=12,\n",
    ")\n",
    "# Plot 4: Sampling Metrics Bar Plot (Bottom-right, smaller height)\n",
    "ax4 = fig.add_subplot(gs[1, 1])\n",
    "left_val = 0.0\n",
    "for m in order_metrics:\n",
    "    val = float(plot_df.loc[plot_df['Metric'] == m, 'Percent'].values[0]) if m in list(plot_df['Metric']) else 0.0\n",
    "    bar_color = color_map_metrics[m]\n",
    "    ax4.barh([0], [val], left=left_val, color=bar_color, edgecolor='none', linewidth=0)\n",
    "    # Determine text color based on bar color brightness\n",
    "    rgb = mcolors.to_rgb(bar_color)\n",
    "    brightness = rgb_to_hsv(rgb)[2]  # Get the value (brightness) from HSV\n",
    "    text_color = 'white' if brightness < 0.5 else 'black'\n",
    "    ax4.text(left_val + val / 2, 0, f'{val:.0f}%', ha='center', va='center', fontsize=14, color=text_color)\n",
    "    left_val += val\n",
    "# Add small white gaps between segments\n",
    "gap_left = 0.0\n",
    "for m in order_metrics[:-1]:\n",
    "    # Safely get percent for the metric, default to 0.0 when missing\n",
    "    val_gap = float(plot_df.loc[plot_df['Metric'] == m, 'Percent'].values[0]) if m in list(plot_df['Metric']) else 0.0\n",
    "    gap_left += val_gap\n",
    "    ax4.vlines(gap_left, -0.4, 0.4, colors='white', linewidth=2)\n",
    "# Style for Plot 4\n",
    "ax4.set_xticks([])\n",
    "ax4.set_yticks([])\n",
    "ax4.set_title('Occurrence metrics across records', pad=20, fontsize=14)\n",
    "ax4.spines['top'].set_visible(False)\n",
    "ax4.spines['right'].set_visible(False)\n",
    "ax4.spines['left'].set_visible(False)\n",
    "ax4.spines['bottom'].set_visible(False)\n",
    "ax4.grid(False)\n",
    "# Add legend for Plot 4\n",
    "legend_handles = [Patch(facecolor=color_map_metrics[m], edgecolor='none', label=m) for m in order_metrics]\n",
    "ax4.legend(\n",
    "    handles=legend_handles,\n",
    "    loc='upper center',\n",
    "    bbox_to_anchor=(0.5, 1.6),  # Position the legend below the plot\n",
    "    ncol=2,  # Number of columns in the legend\n",
    "    frameon=False,  #Remove the legend box\n",
    "    fontsize=12,\n",
    ")\n",
    "# Adjust layout\n",
    "plt.tight_layout()\n",
    "plt.subplots_adjust(hspace=-0.375, wspace=0.02)\n",
    "# Center the bottom bars under their corresponding maps\n",
    "pos1 = ax1.get_position()\n",
    "pos2 = ax2.get_position()\n",
    "pos3 = ax3.get_position()\n",
    "pos4 = ax4.get_position()\n",
    "bar_width_scale = 0.92\n",
    "new_w1 = pos1.width * bar_width_scale\n",
    "new_w2 = pos2.width * bar_width_scale\n",
    "ax3.set_position([pos1.x0 + (pos1.width - new_w1) / 2, pos3.y0, new_w1, pos3.height])\n",
    "ax4.set_position([pos2.x0 + (pos2.width - new_w2) / 2, pos4.y0, new_w2, pos4.height])\n",
    " \n",
    "plt.savefig('Figures/panel_biomass_abundance.png', dpi=300, bbox_inches='tight', facecolor='white')\n",
    "\n"
   ]
