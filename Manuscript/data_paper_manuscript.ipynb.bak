   ],
   "source": [
    "#| fig-pos: \"H\"\n",
    "#| label: fig-geo\n",
    "#| fig-cap: \"a) Number of records and taxa of benthic invertebrates in the BENTH-MARC database per geomorphological category. Figure 6: b) A visual representation of the geomorphological categories, simplified from Harris *et al.* [@harris2014]. \"\n",
    "\n",
    "# ------------------------------------------ Map ------------------------------------------------\n",
    "\n",
    "# Cell 1 — Imports and config\n",
    "\n",
    "# Folder containing your shapefiles\n",
    "geo_dir = 'Geo'\n",
    "# List of shapefile filenames to load from ./Geo (add more as needed)\n",
    "layer_files = [\n",
    "    'Hadal.shp',\n",
    "    'Abyss.shp',\n",
    "    'Slope.shp',\n",
    "    'Shelf.shp',\n",
    "    'Abyssal_Classification.shp',\n",
    "    'Shelf_Classification.shp',\n",
    "    'Spreading_ridges.shp',\n",
    "    'Ridges.shp',\n",
    "    'Rift_valleys.shp',\n",
    "    'Seamounts.shp'\n",
    "]\n",
    "\n",
    "# Cell 2 — Load shapefiles from ./Geo\n",
    "layers = {}\n",
    "for fname in layer_files:\n",
    "    fpath = os.path.join(geo_dir, fname)\n",
    "    if os.path.exists(fpath):\n",
    "        gdf_loaded = gpd.read_file(fpath)\n",
    "        key_name = os.path.splitext(fname)[0]\n",
    "        layers[key_name] = gdf_loaded\n",
    "\n",
    "# Cell 3 — Configure class colors (RGBA) and defaults\n",
    "abyssal_class_field = 'Class'  # Update this if your column name differs\n",
    "abyssal_class_colors = {\n",
    "    'Hills': (0.498, 0.498, 0.498, 1.0),  # fixed\n",
    "    'Mountains': (0.498, 0.498, 0.498, 1.0),  # fixed\n",
    "    'Plains': (0.8, 0.8, 0.8, 1.0)   # fixed\n",
    "}\n",
    "shelf_class_field = 'Class'  # Update this if your column name differs\n",
    "shelf_class_colors = {\n",
    "    'high': (0.251, 0.247, 0.106, 1.0),  # Light blue\n",
    "    'medium': (0.522, 0.486, 0.180, 1.0),  # Green\n",
    "    'low': (0.749, 0.773, 0.345, 1.0)   # Orange\n",
    "}\n",
    "layer_colors_rgba = {\n",
    "    'Hadal': (0.8, 0.8, 0.8, 1.0),  # Dark blue, previously (0.129, 0.443, 0.710, 1.0)\n",
    "    'Abyss': (0.420, 0.682, 0.843, 1.0),  # Light blue\n",
    "    'Ridges': (0.502, 0.063, 0.482, 1.0),  # Purple\n",
    "    'Slope': (0.745, 0.843, 0.906, 1.0),  # Purple\n",
    "    'Shelf': (0.933, 0.953, 1.0, 1.0),  # Purple\n",
    "    'Spreading_ridges': (0.502, 0.063, 0.482, 1.0),  # Purple\n",
    "    'Rift_valleys': (0.502, 0.063, 0.482, 1.0),  # Purple\n",
    "    'Seamounts': (0.498, 0.498, 0.498, 1.0)  # Purple\n",
    "}\n",
    "default_color = (0.5, 0.5, 0.5, 0.5)  # Gray with transparency\n",
    "\n",
    "# Simplify geometries for faster plotting\n",
    "simp_tol_deg = 0.02\n",
    "simplified_layers = {}\n",
    "for lname, gdf in layers.items():\n",
    "    sgdf = gdf.copy()\n",
    "    sgdf['geometry'] = sgdf.geometry.simplify(simp_tol_deg, preserve_topology=True)\n",
    "    simplified_layers[lname] = sgdf\n",
    "\n",
    "# Cell 4 — Plot preview (rasterized)\n",
    "fig = plt.figure(figsize=(8, 8))\n",
    "ax = plt.axes(projection=ccrs.NorthPolarStereo())\n",
    "ax.set_extent([-180, 180, 50, 90], crs=ccrs.PlateCarree())\n",
    "ax.add_feature(cfeature.LAND, facecolor='whitesmoke', zorder=0)\n",
    "ax.add_feature(cfeature.OCEAN, facecolor='aliceblue', zorder=0)\n",
    "ax.coastlines(resolution='110m', linewidth=0.4, color='black', zorder=2)\n",
    "legend_handles = []\n",
    "# Define zorder for each layer explicitly\n",
    "layer_zorder = {\n",
    "    'Hadal': 3,\n",
    "    'Abyss': 4,\n",
    "    'Abyssal_Classification': 5,\n",
    "    'Shelf_Classification': 8,\n",
    "    'Slope': 7,\n",
    "    'Shelf': 6,\n",
    "    'Spreading_ridges': 9,\n",
    "    'Ridges': 10,\n",
    "    'Rift_valleys': 11,\n",
    "    'Seamounts': 12\n",
    "}\n",
    "# Plot layers in the specified order with explicit zorder\n",
    "for fname in layer_files:\n",
    "    lname = os.path.splitext(fname)[0]  # Get layer name without extension\n",
    "    if lname in simplified_layers:\n",
    "        gdf = simplified_layers[lname]\n",
    "        rgba = layer_colors_rgba.get(lname, default_color)\n",
    "        geoms = [geom for geom in gdf.geometry if geom is not None]\n",
    "        if len(geoms) > 0:\n",
    "            artist = ax.add_geometries(\n",
    "                geoms,\n",
    "                crs=ccrs.PlateCarree(),\n",
    "                facecolor=rgba,\n",
    "                edgecolor='k',\n",
    "                linewidth=0.15,\n",
    "                alpha=rgba[3],\n",
    "                zorder=layer_zorder[lname]  # Use explicit zorder\n",
    "            )\n",
    "            legend_handles.append(Patch(facecolor=rgba, edgecolor='k', label=lname))\n",
    "# Plot Abyssal_Classification with class-specific colors\n",
    "if 'Abyssal_Classification' in simplified_layers:\n",
    "    gdfc = simplified_layers['Abyssal_Classification']\n",
    "    for cls_name, cls_rgba in abyssal_class_colors.items():\n",
    "        subset = gdfc[gdfc[abyssal_class_field].astype(str) == cls_name]\n",
    "        geoms = [geom for geom in subset.geometry if geom is not None]\n",
    "        if len(geoms) > 0:\n",
    "            artist = ax.add_geometries(\n",
    "                geoms,\n",
    "                crs=ccrs.PlateCarree(),\n",
    "                facecolor=cls_rgba,\n",
    "                edgecolor='k',\n",
    "                linewidth=0.12,\n",
    "                alpha=cls_rgba[3],\n",
    "                zorder=layer_zorder['Abyssal_Classification']  # Explicit zorder for Abyssal_Classification\n",
    "            )\n",
    "            legend_handles.append(Patch(facecolor=cls_rgba, edgecolor='k', label='Abyssal ' + cls_name))\n",
    "ax.text(0.01, 0.99, 'b)', transform=ax.transAxes, ha='left', va='top', fontsize=14, fontweight='bold', zorder=20)\n",
    "# Plot Shelf_Classification with class-specific colors\n",
    "if 'Shelf_Classification' in simplified_layers:\n",
    "    gdfc = simplified_layers['Shelf_Classification']\n",
    "    for cls_name, cls_rgba in shelf_class_colors.items():\n",
    "        subset = gdfc[gdfc[shelf_class_field].astype(str) == cls_name]\n",
    "        geoms = [geom for geom in subset.geometry if geom is not None]\n",
    "        if len(geoms) > 0:\n",
    "            artist = ax.add_geometries(\n",
    "                geoms,\n",
    "                crs=ccrs.PlateCarree(),\n",
    "                facecolor=cls_rgba,\n",
    "                edgecolor='k',\n",
    "                linewidth=0.12,\n",
    "                alpha=cls_rgba[3],\n",
    "                zorder=layer_zorder['Shelf_Classification']  # Explicit zorder for Shelf_Classification\n",
    "            )\n",
    "\n",
    "plt.tight_layout()\n",
    "out_path = 'Figures/geo_map.png'\n",
    "plt.savefig(out_path, dpi=300)\n",
    "plt.show()\n"
   ]
  },
