   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "6dddcc3b",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/markdown": [
       "@fig-top10phyla shows an overview of the top ten most record-rich phyla in BENTH-MARC. The number of records is compared to the number of unique taxa per phylum. Annelida is by far the phylum with the highest number of records, with a share of 44% of the total number of records. However, the highest number of unique taxa can be found within the phylum Arthropoda, even though it only has 17% of the total number of records. The phylum Bryozoa stands out in terms of having the highest taxa to records ratio. "
      ],
      "text/plain": [
       "<IPython.core.display.Markdown object>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "display(Markdown(\n",
    "    f\"@fig-top10phyla shows an overview of the top ten most record-rich phyla in BENTH-MARC. The number of records is compared to the number of unique taxa per \"\n",
    "    f\"phylum. Annelida is by far the phylum with the highest number of records, with a share of {percent_annelida:.0f}% of the total number of records. However, the highest number of unique taxa \"\n",
    "    f\"can be found within the phylum Arthropoda, even though it only has {percent_arthropoda:.0f}% of the total number of records. The phylum Bryozoa stands out in terms of having the highest taxa to records ratio. \"\n",
    "))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 76,
   "id": "dba9e3ba-8fdb-453b-98da-920e24d8b240",
   "metadata": {},
   "outputs": [],
   "source": [
    "#--- FIGURE with top 10 phyla by unique taxa and nr of records ---"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "82ccb4bc-16af-4b59-a8bd-6189ef3e67c9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load the parquet file and compute rank-split metrics by phylum\n",
    "df_main = pd.read_parquet('Final/merged_all_final.parquet')\n",
    "df_main.columns = [c.strip() for c in df_main.columns]\n",
    "phylum_col = 'phylum'\n",
    "accepted_col = 'aphiaID'\n",
    "rank_col = 'taxonRank'\n",
    "\n",
    "required_cols = [phylum_col, accepted_col, rank_col]\n",
    "missing = [c for c in required_cols if c not in df_main.columns]\n",
    "if missing:\n",
    "    raise KeyError(f\"Missing required column(s): {missing}\")\n",
    "\n",
    "# Normalize rank values\n",
    "rank_norm = df_main[rank_col].astype(str).str.strip().str.upper()\n",
    "\n",
    "# Record counts (left side): total + SPECIES subset\n",
    "total_records = df_main.groupby(phylum_col, dropna=False).size().reset_index(name='records_total')\n",
    "species_records = (\n",
    "    df_main[rank_norm == 'SPECIES']\n",
    "    .groupby(phylum_col, dropna=False)\n",
    "    .size()\n",
    "    .reset_index(name='records_species')\n",
    ")\n",
    "\n",
    "# Unique AphiaIDs (right side): treat an AphiaID as species-level if any row is SPECIES\n",
    "df_main[accepted_col] = pd.to_numeric(df_main[accepted_col], errors='coerce')\n",
    "species_unique = (\n",
    "    df_main.dropna(subset=[accepted_col])\n",
    "    .assign(is_species=(rank_norm == 'SPECIES'))\n",
    "    .groupby([phylum_col, accepted_col], dropna=False)['is_species']\n",
    "    .max()\n",
    "    .reset_index()\n",
    "    .groupby(phylum_col, dropna=False)['is_species']\n",
    "    .agg(unique_species='sum', unique_total='size')\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "metrics = (\n",
    "    total_records.merge(species_records, on=phylum_col, how='left')\n",
    "    .merge(species_unique, on=phylum_col, how='left')\n",
    "    .fillna(0)\n",
    ")\n",
    "metrics['records_total'] = metrics['records_total'].astype(int)\n",
    "metrics['records_species'] = metrics['records_species'].astype(int)\n",
    "metrics['records_other'] = (metrics['records_total'] - metrics['records_species']).astype(int)\n",
    "metrics['unique_total'] = metrics['unique_total'].astype(int)\n",
    "metrics['unique_species'] = metrics['unique_species'].astype(int)\n",
    "metrics['unique_other'] = (metrics['unique_total'] - metrics['unique_species']).astype(int)\n",
    "\n",
    "# Union selection (top 10 by each metric)\n",
    "top10_records = metrics.sort_values('records_total', ascending=False).head(10)[phylum_col].tolist()\n",
    "top10_unique = metrics.sort_values('unique_total', ascending=False).head(10)[phylum_col].tolist()\n",
    "selected_union = list(dict.fromkeys(top10_records + top10_unique))\n",
    "\n",
    "# Order by total records for plotting\n",
    "df_union = metrics[metrics[phylum_col].isin(selected_union)].copy()\n",
    "order_union = df_union.sort_values('records_total', ascending=False)[phylum_col].tolist()\n",
    "\n",
    "# Overall species shares across selected phyla (for annotation)\n",
    "total_records_union = df_union['records_total'].sum()\n",
    "species_records_union = df_union['records_species'].sum()\n",
    "records_species_pct_union = (species_records_union / total_records_union * 100) if total_records_union > 0 else 0.0\n",
    "\n",
    "total_unique_union = df_union['unique_total'].sum()\n",
    "species_unique_union = df_union['unique_species'].sum()\n",
    "unique_species_pct_union = (species_unique_union / total_unique_union * 100) if total_unique_union > 0 else 0.0"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "26a165ec-3bfe-43bd-8b93-e4984dbfa285",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x600 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "#| label: fig-top10phyla\n",
    "#| fig-cap: \"The number of records (left side) and taxa (right side)of the ten most records-rich phyla of benthic invertebrates in the BENTH-MARC database. The proportion of species-level data is indicated in teal and by numbers in the bar plot, while grey indicates data on other taxonomic levels. \"\n",
    "#| fig-pos: \"H\"\n",
    "\n",
    "# Plot mirrored stacked barplot (UNION of top-10 by each metric)\n",
    "# Left: records, Right: unique AphiaIDs\n",
    "phylum_col = 'phylum'\n",
    "plot_df = df_union.set_index(phylum_col).loc[order_union].reset_index()\n",
    "\n",
    "species_color = '#9DC8D2'\n",
    "other_color = '#E0E0E0'\n",
    "\n",
    "# Darker text shade for species labels\n",
    "species_label_color = mcolors.to_hex(np.array(mcolors.to_rgb(species_color)) * 0.55)\n",
    "\n",
    "fig, (ax_left, ax_right) = plt.subplots(\n",
    "    ncols=2,\n",
    "    figsize=(12, max(6, int(len(order_union) * 0.6))),\n",
    "    gridspec_kw={'width_ratios': [1, 1]}\n",
    ")\n",
    "\n",
    "y = np.arange(len(plot_df))\n",
    "\n",
    "# Left side (records): negative values to mirror\n",
    "ax_left.barh(y, -plot_df['records_species'], color=species_color, label='Species')\n",
    "ax_left.barh(y, -plot_df['records_other'], left=-plot_df['records_species'], color=other_color, label='Other ranks')\n",
    "\n",
    "# Right side (unique AphiaIDs): positive values\n",
    "ax_right.barh(y, plot_df['unique_species'], color=species_color, label='Species')\n",
    "ax_right.barh(y, plot_df['unique_other'], left=plot_df['unique_species'], color=other_color, label='Other ranks')\n",
    "\n",
    "left_max = float(plot_df['records_total'].max())\n",
    "right_max = float(plot_df['unique_total'].max())\n",
    "\n",
    "# Axes formatting with room for outside species labels\n",
    "ax_left.set_xlabel('Number of records', fontsize=14)\n",
    "ax_left.set_xlim(-left_max * 1.36, 0)\n",
    "ax_left.xaxis.set_major_formatter(FuncFormatter(lambda x, pos: f'{int(abs(x)):,}'))\n",
    "ax_left.xaxis.set_major_locator(MaxNLocator(nbins=5, prune='both'))\n",
    "ax_left.spines['right'].set_visible(False)\n",
    "ax_left.spines['top'].set_visible(False)\n",
    "\n",
    "ax_right.set_xlabel('Number of unique taxa', fontsize=14)\n",
    "ax_right.set_xlim(0, right_max * 1.22)\n",
    "ax_right.xaxis.set_major_formatter(FuncFormatter(lambda x, pos: f'{int(x):,}'))\n",
    "ax_right.xaxis.set_major_locator(MaxNLocator(nbins=5, prune='both'))\n",
    "ax_right.spines['left'].set_visible(False)\n",
    "ax_right.spines['top'].set_visible(False)\n",
    "\n",
    "# Add gridlines\n",
    "ax_left.grid(axis='y', color='gray', linestyle='--', linewidth=0.5, alpha=0.7)\n",
    "ax_right.grid(axis='y', color='gray', linestyle='--', linewidth=0.5, alpha=0.7)\n",
    "\n",
    "# Explicit y-ticks and labels\n",
    "ax_left.set_yticks(y)\n",
    "ax_left.set_yticklabels(order_union, fontsize=12)\n",
    "ax_right.set_yticks(y)\n",
    "ax_right.set_yticklabels([])\n",
    "\n",
    "# Draw once so renderer is available for text-size checks\n",
    "fig.canvas.draw()\n",
    "renderer = fig.canvas.get_renderer()\n",
    "\n",
    "def text_fits_segment(ax, text, x_center, y_center, seg_width, pad_px=8, fontsize=12, fontweight='bold'):\n",
    "    tmp = ax.text(x_center, y_center, text, fontsize=fontsize, fontweight=fontweight, alpha=0.0)\n",
    "    bb = tmp.get_window_extent(renderer=renderer)\n",
    "    tmp.remove()\n",
    "\n",
    "    x0 = ax.transData.transform((x_center - seg_width / 2.0, y_center))[0]\n",
    "    x1 = ax.transData.transform((x_center + seg_width / 2.0, y_center))[0]\n",
    "    seg_px = abs(x1 - x0)\n",
    "    return bb.width <= max(0, seg_px - pad_px)\n",
    "\n",
    "left_outside_offset = left_max * 0.12\n",
    "right_outside_offset = right_max * 0.10\n",
    "\n",
    "# Add species labels only: inside when fit, otherwise outside with connector lines\n",
    "for i, row in plot_df.iterrows():\n",
    "    rec_species = int(row['records_species'])\n",
    "    uniq_species = int(row['unique_species'])\n",
    "\n",
    "    rec_species_str = f\"{rec_species:,}\"\n",
    "    uniq_species_str = f\"{uniq_species:,}\"\n",
    "\n",
    "    # Left panel species labels\n",
    "    rec_species_center = -rec_species / 2.0\n",
    "    rec_species_edge = -rec_species\n",
    "\n",
    "    if rec_species > 0 and text_fits_segment(ax_left, rec_species_str, rec_species_center, y[i], rec_species):\n",
    "        ax_left.text(\n",
    "            rec_species_center, y[i], rec_species_str,\n",
    "            ha='center', va='center', fontsize=12,\n",
    "            color=species_label_color, fontweight='bold'\n",
    "        )\n",
    "    else:\n",
    "        rec_label_x = rec_species_edge - left_outside_offset\n",
    "        ax_left.annotate(\n",
    "            rec_species_str,\n",
    "            xy=(rec_species_center, y[i]),\n",
    "            xytext=(rec_label_x, y[i]),\n",
    "            ha='right', va='center',\n",
    "            fontsize=12, color=species_label_color, fontweight='bold',\n",
    "            arrowprops=dict(arrowstyle='-', color=species_label_color, lw=1.1, shrinkA=0, shrinkB=0)\n",
    "        )\n",
    "\n",
    "    # Right panel species labels\n",
    "    uniq_species_center = uniq_species / 2.0\n",
    "    uniq_species_edge = uniq_species\n",
    "\n",
    "    if uniq_species > 0 and text_fits_segment(ax_right, uniq_species_str, uniq_species_center, y[i], uniq_species):\n",
    "        ax_right.text(\n",
    "            uniq_species_center, y[i], uniq_species_str,\n",
    "            ha='center', va='center', fontsize=12,\n",
    "            color=species_label_color, fontweight='bold'\n",
    "        )\n",
    "    else:\n",
    "        uniq_label_x = uniq_species_edge + right_outside_offset\n",
    "        ax_right.annotate(\n",
    "            uniq_species_str,\n",
    "            xy=(uniq_species_center, y[i]),\n",
    "            xytext=(uniq_label_x, y[i]),\n",
    "            ha='left', va='center',\n",
    "            fontsize=12, color=species_label_color, fontweight='bold',\n",
    "            arrowprops=dict(arrowstyle='-', color=species_label_color, lw=1.1, shrinkA=0, shrinkB=0)\n",
    "        )\n",
    "\n",
    "# Show overall species shares in each metric\n",
    "ax_left.text(\n",
    "    0.02, 1.02,\n",
    "    f\"Species share: {records_species_pct_union:.1f}%\",\n",
    "    transform=ax_left.transAxes,\n",
    "    fontsize=14,\n",
    "    ha='left',\n",
    "    va='bottom'\n",
    ")\n",
    "ax_right.text(\n",
    "    0.98, 1.02,\n",
    "    f\"Species share: {unique_species_pct_union:.1f}%\",\n",
    "    transform=ax_right.transAxes,\n",
    "    fontsize=14,\n",
    "    ha='right',\n",
    "    va='bottom'\n",
    ")\n",
    "\n",
    "# Shared legend\n",
    "legend_handles = [\n",
    "    Patch(facecolor=species_color, edgecolor='none', label='Species'),\n",
    "    Patch(facecolor=other_color, edgecolor='none', label='Other taxonomic levels')\n",
    "]\n",
    "fig.legend(\n",
    "    handles=legend_handles,\n",
    "    loc='upper center',\n",
    "    ncol=2,\n",
    "    frameon=False,\n",
    "    bbox_to_anchor=(0.57, 1.03),\n",
    "    fontsize=18\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.subplots_adjust(top=0.86, wspace=0.02)\n",
    "\n",
    "outfile_labels = 'Figures/toptenphyla.png'\n",
    "plt.savefig(outfile_labels, dpi=220, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
