  {
   "cell_type": "code",
   "execution_count": 79,
   "id": "8b2ec92f-90ad-4b1b-8141-5c833e48a51f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Figure panel with biomass and sampling metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 72,
   "id": "198312df",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Prepare data for fig-panelmap from all_merged.parquet\n",
    "panel_cols = [\n",
    "    'datasetKey',\n",
    "    'decimalLatitudeStart',\n",
    "    'decimalLongitudeStart',\n",
    "    'year',\n",
    "    'startDayOfYear',\n",
    "    'biomass',\n",
    "    'individualCount',\n",
    "    'areaSampled'\n",
    "]\n",
    "\n",
    "df_panel = pd.read_parquet('Final/merged_all_final.parquet', columns=panel_cols).copy()\n",
    "\n",
    "station_cols_required = ['datasetKey', 'decimalLatitudeStart', 'decimalLongitudeStart', 'startDayOfYear']\n",
    "\n",
    "# Keep station coordinates at full precision and include startDayOfYear in station key\n",
    "df_panel['decimalLatitudeStart'] = pd.to_numeric(df_panel['decimalLatitudeStart'], errors='coerce')\n",
    "df_panel['decimalLongitudeStart'] = pd.to_numeric(df_panel['decimalLongitudeStart'], errors='coerce')\n",
    "df_panel['year'] = pd.to_numeric(df_panel['year'], errors='coerce').astype('Int64')\n",
    "df_panel['startDayOfYear'] = pd.to_numeric(df_panel['startDayOfYear'], errors='coerce').astype('Int64')\n",
    "\n",
    "station_key = ['datasetKey', 'decimalLatitudeStart', 'decimalLongitudeStart', 'year', 'startDayOfYear']\n",
    "\n",
    "\n",
    "def has_info(series):\n",
    "    vals = series.astype('string').str.strip().str.lower()\n",
    "    return ~(series.isna() | vals.isin(['', 'nan', 'none', '<na>']))\n",
    "\n",
    "# Record-level flags\n",
    "df_panel['has_biomass'] = has_info(df_panel['biomass']) & has_info(df_panel['areaSampled'])\n",
    "df_panel['is_abundance'] = has_info(df_panel['individualCount']) & has_info(df_panel['areaSampled'])\n",
    "\n",
    "# ---------------- Biomass coverage ----------------\n",
    "biomass_station = (\n",
    "    df_panel.groupby(station_key, dropna=False, as_index=False)['has_biomass']\n",
    "            .agg(n_with='sum', n_total='count')\n",
    ")\n",
    "biomass_station['biomass_coverage'] = np.select(\n",
    "    [biomass_station['n_with'] == 0, biomass_station['n_with'] == biomass_station['n_total']],\n",
    "    ['None', 'Full'],\n",
    "    default='partial'\n",
    ")\n",
    "\n",
    "coords_biomass = biomass_station.rename(\n",
    "    columns={'decimalLongitudeStart': 'lon', 'decimalLatitudeStart': 'lat'}\n",
    ")[['lon', 'lat', 'biomass_coverage']].copy()\n",
    "coords_biomass = coords_biomass[\n",
    "    (coords_biomass['lat'] >= -90) & (coords_biomass['lat'] <= 90) &\n",
    "    (coords_biomass['lon'] >= -180) & (coords_biomass['lon'] <= 180)\n",
    "]\n",
    "\n",
    "drawing_order_biomass = ['None', 'partial', 'Full']\n",
    "coverage_colors = {\n",
    "    'None': '#9DC8D2',\n",
    "    'partial': '#BC6D78',\n",
    "    'Full': '#2C3E50'\n",
    "}\n",
    "\n",
    "records_biomass = pd.Series({\n",
    "    'None': int((~df_panel['has_biomass']).sum()),\n",
    "    'Full': int(df_panel['has_biomass'].sum())\n",
    "})\n",
    "total_obs = int(records_biomass.sum())\n",
    "labels_biomass = ['None', 'Full']\n",
    "counts_biomass = [records_biomass['None'], records_biomass['Full']]\n",
    "colors_biomass = ['#9DC8D2', '#2C3E50']\n",
    "\n",
    "# ---------------- Occurrence metrics ----------------\n",
    "# Record-level classification: abundance requires BOTH individualCount and areaSampled\n",
    "df_panel['metric_record'] = np.where(df_panel['is_abundance'], 'Abundance', 'Presence')\n",
    "\n",
    "metric_station = (\n",
    "    df_panel.groupby(station_key, dropna=False, as_index=False)['metric_record']\n",
    "            .nunique()\n",
    "            .rename(columns={'metric_record': 'n_metric_types'})\n",
    ")\n",
    "any_abundance = (\n",
    "    df_panel.groupby(station_key, dropna=False)['is_abundance']\n",
    "            .any()\n",
    "            .rename('any_abundance')\n",
    "            .reset_index()\n",
    ")\n",
    "metric_station = metric_station.merge(any_abundance, on=station_key, how='left')\n",
    "metric_station['metric_category'] = np.select(\n",
    "    [\n",
    "        metric_station['n_metric_types'] > 1,\n",
    "        metric_station['any_abundance']\n",
    "    ],\n",
    "    ['Mixed', 'Abundance'],\n",
    "    default='Presence'\n",
    ")\n",
    "\n",
    "coords_metric = metric_station.rename(\n",
    "    columns={'decimalLongitudeStart': 'lon', 'decimalLatitudeStart': 'lat'}\n",
    ")[['lon', 'lat', 'metric_category']].copy()\n",
    "coords_metric = coords_metric[\n",
    "    (coords_metric['lat'] >= -90) & (coords_metric['lat'] <= 90) &\n",
    "    (coords_metric['lon'] >= -180) & (coords_metric['lon'] <= 180)\n",
    "]\n",
    "\n",
    "drawing_order_metric = ['Presence', 'Mixed', 'Abundance']\n",
    "colors_metric = {\n",
    "    'Presence': '#9DC8D2',\n",
    "    'Mixed': '#BC6D78',\n",
    "    'Abundance': '#2C3E50'\n",
    "}\n",
    "\n",
    "plot_df = (\n",
    "    df_panel['metric_record']\n",
    "    .value_counts()\n",
    "    .reindex(['Presence', 'Abundance'], fill_value=0)\n",
    "    .rename_axis('Metric')\n",
    "    .reset_index(name='Count')\n",
    ")\n",
    "plot_df['Percent'] = np.where(plot_df['Count'].sum() > 0, (plot_df['Count'] / plot_df['Count'].sum()) * 100.0, 0.0)\n"
   ]
  },
