     ]
    }
   ],
   "source": [
    "#| include: false\n",
    "# Use station-level unique AphiaID counts from df_taxa when available; otherwise load fallback data\n",
    "df_taxa_local = globals().get('df_taxa', None)\n",
    "\n",
    "if isinstance(df_taxa_local, pd.DataFrame) and 'uniqueAphiaIDCount' in df_taxa_local.columns:\n",
    "\ttaxa_counts = pd.to_numeric(df_taxa_local['uniqueAphiaIDCount'], errors='coerce').dropna()\n",
    "else:\n",
    "\ttaxa_path = 'Final/all_stations.parquet'\n",
    "\tdf_taxa_fallback = pd.read_parquet(taxa_path)\n",
    "\n",
    "\tif 'uniqueAphiaIDCount' in df_taxa_fallback.columns:\n",
    "\t\ttaxa_counts = pd.to_numeric(df_taxa_fallback['uniqueAphiaIDCount'], errors='coerce').dropna()\n",
    "\telse:\n",
    "\t\t# Last resort: compute unique AphiaIDs per station from all_merged\n",
    "\t\tif 'all_merged' not in globals():\n",
    "\t\t\tall_merged = pd.read_parquet('..//All data//all_merged.parquet')\n",
    "\n",
    "\t\tneeded = ['datasetKey', 'decimalLatitudeStart', 'decimalLongitudeStart', 'year', 'aphiaID']\n",
    "\t\tmissing_cols = [c for c in needed if c not in all_merged.columns]\n",
    "\t\tif missing_cols:\n",
    "\t\t\traise KeyError(f\"Missing required column(s): {missing_cols}\")\n",
    "\n",
    "\t\ttmp = all_merged[needed].copy()\n",
    "\t\ttmp['decimalLatitudeStart'] = pd.to_numeric(tmp['decimalLatitudeStart'], errors='coerce').round(5)\n",
    "\t\ttmp['decimalLongitudeStart'] = pd.to_numeric(tmp['decimalLongitudeStart'], errors='coerce').round(5)\n",
    "\t\ttmp['year'] = pd.to_numeric(tmp['year'], errors='coerce').round().astype('Int64')\n",
    "\t\ttmp = tmp.dropna(subset=['datasetKey', 'decimalLatitudeStart', 'decimalLongitudeStart'])\n",
    "\n",
    "\t\ttaxa_counts = tmp.groupby(\n",
    "\t\t\t['datasetKey', 'decimalLatitudeStart', 'decimalLongitudeStart', 'year'],\n",
    "\t\t\tdropna=False\n",
    "\t\t)['aphiaID'].nunique()\n",
    "\n",
    "# Percent of stations with < 10 AphiaIDs\n",
    "pct_lt_10 = (taxa_counts < 10).mean() * 100 if len(taxa_counts) > 0 else np.nan\n",
    "\n",
    "# 90th percentile AphiaIDs per station\n",
    "p90_taxa = taxa_counts.quantile(0.90) if len(taxa_counts) > 0 else np.nan\n",
    "\n",
    "# Optional integer threshold form (useful for text like \"90% have less than X\")\n",
    "x_for_90pct_lt = int(np.ceil(p90_taxa)) if pd.notna(p90_taxa) else None\n",
    "\n",
    "# Highest number of AphiaIDs at one station\n",
    "max_taxa = int(taxa_counts.max()) if len(taxa_counts) > 0 else None\n",
    "\n",
    "# Lowest number of AphiaIDs at one station\n",
    "min_taxa = int(taxa_counts.min()) if len(taxa_counts) > 0 else None\n",
    "\n",
    "print(f\"Stations with <10 AphiaIDs: {pct_lt_10:.1f}%\")\n",
    "print(f\"90th percentile AphiaIDs per station: {p90_taxa:.1f}\")\n",
    "print(f\"Highest AphiaIDs at one station: {max_taxa}\")\n",
    "print(f\"Lowest AphiaIDs at one station: {min_taxa}\")"
   ]
  },
