   ],
   "source": [
    "#| fig-pos: \"H\"\n",
    "#| label: fig-panelmap\n",
    "#| fig-cap: \"Benthic invertebrates in BENTH-MARC by a) biomass coverage, b) occurrence metrics and c) gear information across stations and records, as well as d) number of unique taxa per station. In 4 d), stations with higher numbers of taxa are drawn on top of stations with lower numbers of taxa.\"\n",
    "\n",
    "\n",
    "# ------------------------------ NEXT FIGURE -----------------------------------------\n",
    "\n",
    "\n",
    "# Create a figure with a custom grid layout\n",
    "fig = plt.figure(figsize=(12, 10))\n",
    "gs = gridspec.GridSpec(\n",
    "    2, 2,  # 2 rows, 2 columns\n",
    "    width_ratios=[1, 1],  # Adjust the width of each column\n",
    "    height_ratios=[2, 0.1]  # Adjust the height of each row\n",
    ")\n",
    "# Subplot 1: Map with number of records per station\n",
    "proj = ccrs.NorthPolarStereo()\n",
    "ax1 = fig.add_subplot(gs[0, 1], projection=proj)\n",
    "ax1.set_extent([-180, 180, 50, 90], crs=ccrs.PlateCarree())\n",
    "ax1.add_feature(cfeature.LAND, facecolor='whitesmoke')\n",
    "ax1.add_feature(cfeature.OCEAN, facecolor='aliceblue')\n",
    "ax1.coastlines(resolution='10m', linewidth=0.2, color='black')\n",
    "ax1.gridlines(draw_labels=False, linewidth=0.3, color='gray', alpha=0.5, linestyle='--')\n",
    "# Scatter plot for records per station\n",
    "vmin_records = float(plot_df_taxa['uniqueAphiaIDCount'].min())\n",
    "true_max_records = float(plot_df_taxa['uniqueAphiaIDCount'].max())\n",
    "display_vmax_records = true_max_records\n",
    "if display_vmax_records <= vmin_records:\n",
    "    display_vmax_records = vmin_records + 1.0\n",
    "norm_records = mpl.colors.Normalize(vmin=vmin_records, vmax=display_vmax_records, clip=True)\n",
    "taxa_break_20 = 20\n",
    "taxa_break_150 = 150\n",
    "norm_span = display_vmax_records - vmin_records\n",
    "if norm_span <= 0:\n",
    "    norm_span = 1.0\n",
    "pos_20 = float(np.clip((taxa_break_20 - vmin_records) / norm_span, 0.0, 1.0))\n",
    "pos_150 = float(np.clip((taxa_break_150 - vmin_records) / norm_span, 0.0, 1.0))\n",
    "soft_width = min(0.08, max((pos_150 - pos_20) / 6.0, 0.02))\n",
    "soft_20_low = max(0.0, pos_20 - soft_width)\n",
    "soft_20_high = min(1.0, pos_20 + soft_width)\n",
    "soft_150_low = max(0.0, pos_150 - soft_width)\n",
    "soft_150_high = min(1.0, pos_150 + soft_width)\n",
    "blue = '#9DC8D2'\n",
    "dark = '#2C3E50'\n",
    "gold = '#F1C40F'\n",
    "blend = lambda color_a, color_b, weight: mcolors.to_hex((1 - weight) * np.array(mcolors.to_rgb(color_a)) + weight * np.array(mcolors.to_rgb(color_b)))\n",
    "new_cmap = mpl.colors.LinearSegmentedColormap.from_list(\n",
    "    'taxa_custom',\n",
    "    [\n",
    "        (0.0, blue),\n",
    "        (soft_20_low, blue),\n",
    "        (pos_20, blend(blue, dark, 0.35)),\n",
    "        (soft_20_high, blend(blue, dark, 0.75)),\n",
    "        (soft_150_low, dark),\n",
    "        (pos_150, blend(dark, gold, 0.35)),\n",
    "        (soft_150_high, blend(dark, gold, 0.75)),\n",
    "        (1.0, gold),\n",
    "    ],\n",
    ")\n",
    "sc = ax1.scatter(\n",
    "    plot_df_taxa['lon'], plot_df_taxa['lat'],\n",
    "    c=plot_df_taxa['uniqueAphiaIDCount'],\n",
    "    s=5, cmap=new_cmap, norm=norm_records,\n",
    "    edgecolors='k', linewidths=0,\n",
    "    transform=ccrs.PlateCarree(), alpha=0.9\n",
    ")\n",
    "ax1.set_title('Number of taxa per station', pad=22, fontsize=14)\n",
    "ax1.text(0.02, 0.98, 'd)', transform=ax1.transAxes, ha='left', va='top', fontsize=14, fontweight='bold', zorder=10)\n",
    "\n",
    "# Subplot 2: Binary gear-information map\n",
    "ax2 = fig.add_subplot(gs[0, 0], projection=ccrs.NorthPolarStereo())\n",
    "ax2.set_extent([-180, 180, 50, 90], crs=ccrs.PlateCarree())\n",
    "ax2.add_feature(cfeature.LAND, facecolor='whitesmoke')\n",
    "ax2.add_feature(cfeature.OCEAN, facecolor='aliceblue')\n",
    "ax2.coastlines(resolution='10m', linewidth=0.2, color='black')\n",
    "ax2.gridlines(draw_labels=False, linewidth=0.3, color='gray', alpha=0.5, linestyle='--')\n",
    "# Loop through gear info categories and plot them\n",
    "for cat in drawing_order_gear:\n",
    "    sub = coords_gear[coords_gear['gear_info'] == cat]\n",
    "    ax2.scatter(\n",
    "        sub['lon'].values,\n",
    "        sub['lat'].values,\n",
    "        s=1,\n",
    "        color=colors_gear.get(cat, 'lightgray'),\n",
    "        alpha=0.7,\n",
    "        label=cat,\n",
    "        transform=ccrs.PlateCarree()\n",
    "    )\n",
    "# Add legend\n",
    "ax2.legend(\n",
    "    loc='upper center',\n",
    "    bbox_to_anchor=(0.5, 1.07),\n",
    "    fontsize=12,\n",
    "    ncol=2,\n",
    "    markerscale=7,\n",
    "    frameon=False,\n",
    "    columnspacing=1\n",
    ")\n",
    "ax2.set_title('Gear information across stations', pad=22, fontsize=14)\n",
    "ax2.text(0.02, 0.98, 'c)', transform=ax2.transAxes, ha='left', va='top', fontsize=14, fontweight='bold', zorder=10)\n",
    "\n",
    "# Subplot 3: Horizontal colorbar\n",
    "ax3 = fig.add_subplot(gs[1, 1])\n",
    "ax3.axis('off')  # Turn off the axis for the colorbar placeholder\n",
    "# Add horizontal colorbar with increased size and thickness\n",
    "sm = mpl.cm.ScalarMappable(norm=norm_records, cmap=new_cmap)\n",
    "sm.set_array([])\n",
    "cb = fig.colorbar(sm, ax=ax3, orientation='horizontal', fraction=1, pad=0.05, aspect=9)\n",
    "# Move ticks, labels, and title above the colorbar\n",
    "cb.ax.xaxis.set_ticks_position('top')  # Move ticks to the top\n",
    "cb.ax.xaxis.set_label_position('top')  # Move label to the top\n",
    "cb.set_label(f'Number of unique taxon IDs per station', fontsize=14, labelpad=8)\n",
    "cb_ticks = [0, 30, 60, 90, 120, 150, 180, 210, 240, 270, int(round(display_vmax_records))]\n",
    "cb_ticks = [tick for tick in cb_ticks if vmin_records <= tick <= display_vmax_records]\n",
    "cb_ticks = np.unique(cb_ticks).tolist()\n",
    "cb.set_ticks(cb_ticks)\n",
    "cb.ax.xaxis.set_major_formatter(FuncFormatter(lambda x, pos: f'{int(x):,}'))\n",
    "cb.ax.tick_params(labelsize=10)  # Adjust tick label size\n",
    "# Remove the border around the colorbar\n",
    "cb.outline.set_visible(False)\n",
    "\n",
    "# Subplot 4: Gear information bar plot (record level)\n",
    "ax4 = fig.add_subplot(gs[1, 0])\n",
    "left_val = 0.0\n",
    "for m in order_gear:\n",
    "    val = float(plot_df_gear.loc[plot_df_gear['Gear info'] == m, 'Percent'].values[0])\n",
    "    bar_color = color_map_gear[m]\n",
    "    ax4.barh([0], [val], left=left_val, color=bar_color, edgecolor='none', linewidth=0)\n",
    "    rgb = mpl.colors.to_rgb(bar_color)\n",
    "    luminance = 0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2]\n",
    "    text_color = 'white' if luminance < 0.5 else 'black'\n",
    "    ax4.text(left_val + val / 2, 0, f'{val:.0f}%', ha='center', va='center', fontsize=14, color=text_color)\n",
    "    left_val += val\n",
    "# Add small white gap between the two segments\n",
    "gap_left = float(plot_df_gear.loc[plot_df_gear['Gear info'] == order_gear[0], 'Percent'].values[0])\n",
    "ax4.vlines(gap_left, -0.4, 0.4, colors='white', linewidth=2)\n",
    "# Style for Plot 4\n",
    "ax4.set_xticks([])\n",
    "ax4.set_yticks([])\n",
    "ax4.set_title('Gear information across records', pad=22, fontsize=14)\n",
    "ax4.spines['top'].set_visible(False)\n",
    "ax4.spines['right'].set_visible(False)\n",
    "ax4.spines['left'].set_visible(False)\n",
    "ax4.spines['bottom'].set_visible(False)\n",
    "ax4.grid(False)\n",
    "# Add legend for Plot 4\n",
    "legend_handles = [Patch(facecolor=color_map_gear[m], edgecolor='none', label=m) for m in order_gear]\n",
    "ax4.legend(\n",
    "    handles=legend_handles,\n",
    "    loc='upper center',\n",
    "    bbox_to_anchor=(0.5, 1.6),\n",
    "    ncol=2,\n",
    "    frameon=False,\n",
    "    fontsize=12,\n",
    ")\n",
    "# Adjust layout and save the panel\n",
    "plt.tight_layout()\n",
    "plt.subplots_adjust(hspace=-0.375)\n",
    "# Center the gear bar under the gear map\n",
    "pos2 = ax2.get_position()\n",
    "pos4 = ax4.get_position()\n",
    "bar_width_scale = 0.92\n",
    "new_w2 = pos2.width * bar_width_scale\n",
    "ax4.set_position([pos2.x0 + (pos2.width - new_w2) / 2, pos4.y0, new_w2, pos4.height])\n",
    "plt.savefig('Figures/panel_gear_taxa.png', dpi=300, bbox_inches='tight', facecolor='white')\n",
    "plt.show()"
   ]
  },
