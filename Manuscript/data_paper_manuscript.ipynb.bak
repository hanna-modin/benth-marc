   ],
   "source": [
    "# | include: false\n",
    "# # Calculate depth statistics from gebcoDepth column\n",
    "df_depth = pd.read_parquet('Final/merged_all_final.parquet', columns=['gebcoDepth'])\n",
    "\n",
    "# Remove NaN values and get absolute depth (convert to positive)\n",
    "depth_valid = df_depth['gebcoDepth'].dropna().abs()\n",
    "\n",
    "# Calculate median depth\n",
    "median_depth_m = depth_valid.median()\n",
    "\n",
    "# Calculate percentage deeper than 300 meters\n",
    "pct_over_300 = (depth_valid > 300).sum() / len(depth_valid) * 100\n",
    "\n",
    "# Calculate percentage in top 1000 meters (0-1000m)\n",
    "pct_in_0_1000 = (depth_valid <= 1000).sum() / len(depth_valid) * 100\n",
    "\n",
    "print(f\"Median depth: {median_depth_m:.0f} meters\")\n",
    "print(f\"Percentage deeper than 300 meters: {pct_over_300:.1f}%\")\n",
    "print(f\"Percentage in top 1000 meters: {pct_in_0_1000:.1f}%\")"
   ]
  },
