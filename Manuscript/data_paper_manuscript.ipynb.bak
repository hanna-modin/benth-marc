   "metadata": {},
   "source": [
    "# Methods\n",
    "## Definition of the study area\n",
    "The main study area consists of 18 Arctic Large Marine Ecosystems (LMEs), which are regions of ocean space of 200,000 km^2^ or greater that have unifying qualities in terms of productivity, bathymetry, hydrography and trophically linked populations [@pamend]. The Arctic LMEs were originally developed by the Arctic Council working group Protection of the Arctic Marine Environment (PAME) in 2006 and updated with revised boundaries in 2013 [@pame2013]. Using ecosystem-based units supports the application of an ecosystem approach to management, which has been promoted within the EU Marine Strategy Framework Directive and OSPAR contexts [@pamend]. @fig-map_stations provides an overview of all sampling stations as well as the spatial extent of the Arctic Large Marine Ecosystems.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "3dd25b24-111d-45da-9c91-b89addb0f953",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x800 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "#| fig-pos: \"H\"\n",
    "#| label: fig-map_stations\n",
    "#| fig-cap: \"Spatial distribution of sampling stations in the BENTH-MARC database. The Arctic Large Marine Ecosystems (purple lines) define the main study area. The Large Marine Ecosystems are Labrador Sea (LS), Hudson Bay (HB), Baffin Bay (BB), Beaufort Sea (BeS), Chukchi Sea (CS), West Bering Sea (WBS), East Bering Sea (EBS), Aleutian Islands (AI), East Siberian Sea (ESS), Laptev Sea (LS), Kara Sea (KS), Barents Sea (BaS), Norwegian Sea (NS), Iceland (I), Faroe Plateau (FP), Greenland Sea (GS), North Canadian Archipelago (NCA) and Central Arctic Ocean (CAO). \"\n",
    "\n",
    "# Ensure shapefile can be read even if .shx is missing\n",
    "os.environ['SHAPE_RESTORE_SHX'] = 'YES'\n",
    "\n",
    "# Load the data from device_water.xlsx\n",
    "FILEPATH = 'Final/all_stations.parquet'\n",
    "df_station = pd.read_parquet(FILEPATH)\n",
    "\n",
    "# Use LatStart and LonStart for coordinates\n",
    "lat = df_station['decimalLatitudeStart'].copy()\n",
    "lon = df_station['decimalLongitudeStart'].copy()\n",
    "\n",
    "# Create coordinates dataframe\n",
    "coords = pd.DataFrame({\n",
    "    'lat': pd.to_numeric(lat, errors='coerce'),\n",
    "    'lon': pd.to_numeric(lon, errors='coerce')\n",
    "})\n",
    "coords = coords.dropna()\n",
    "\n",
    "# Filter to plausible lat/lon ranges\n",
    "coords = coords[(coords['lat'] >= -90) & (coords['lat'] <= 90) &\n",
    "                (coords['lon'] >= -180) & (coords['lon'] <= 180)]\n",
    "\n",
    "\n",
    "# Create the plot with smaller figure size\n",
    "plt.figure(figsize=(8, 8))\n",
    "proj = ccrs.NorthPolarStereo()\n",
    "ax = plt.axes(projection=proj)\n",
    "ax.set_extent([-180, 180, 50, 90], crs=ccrs.PlateCarree())\n",
    "ax.add_feature(cfeature.LAND, facecolor='whitesmoke')\n",
    "ax.add_feature(cfeature.OCEAN, facecolor='aliceblue')\n",
    "ax.coastlines(resolution='10m', linewidth=0.2, color='black')\n",
    "ax.gridlines(draw_labels=False, linewidth=0.3, color='gray', alpha=0.5, linestyle='--')\n",
    "\n",
    "# Add shapefile lines (EPSG:4326, same as stations)\n",
    "shape_reader = Reader('LME_boundaries_2014/lme_2013_wgs.shp')\n",
    "line_feature = cfeature.ShapelyFeature(\n",
    "    list(shape_reader.geometries()),\n",
    "    ccrs.PlateCarree(),\n",
    "    edgecolor='#792D54',\n",
    "    facecolor='none'\n",
    ")\n",
    "ax.add_feature(line_feature, linewidth=1.2)\n",
    "\n",
    "# Read the shapefile with attributes so we can access names\n",
    "gdf_lme = gpd.read_file('LME_boundaries_2014/lme_2013_wgs.shp')\n",
    "\n",
    "# Ensure coordinates for labeling are in EPSG:4326 (PlateCarree)\n",
    "gdf_lme_pc = gdf_lme.to_crs(epsg=4326)\n",
    "\n",
    "# Step 1: Reproject to a projected CRS (e.g., EPSG:3395 for World Mercator)\n",
    "gdf_lme_projected = gdf_lme.to_crs(epsg=3395)\n",
    "# Step 2: Calculate centroids in the projected CRS\n",
    "gdf_lme_projected['centroid'] = gdf_lme_projected.geometry.centroid\n",
    "# Step 3: Reproject centroids back to the original geographic CRS (EPSG:4326)\n",
    "gdf_lme_pc['centroid'] = gdf_lme_projected['centroid'].to_crs(epsg=4326)\n",
    "# Step 4: Extract longitude and latitude for labeling\n",
    "gdf_lme_pc['lon'] = gdf_lme_pc['centroid'].x  # Extract longitude\n",
    "gdf_lme_pc['lat'] = gdf_lme_pc['centroid'].y  # Extract latitude\n",
    "\n",
    "\n",
    "# Step 5: Add labels using the LME field\n",
    "for _, row in gdf_lme_pc.iterrows():\n",
    "    if row['LME'] in ['Central Arctic LME', 'Chukchi Sea LME', 'East Bering Sea LME', 'Alutian Islands LME']:\n",
    "        # Skip these labels in the main loop\n",
    "        continue\n",
    "# Handle specific cases for Barents Sea and Beaufort Sea\n",
    "    if row['LME'] == 'Barents Sea LME':\n",
    "        short_label = 'BaS'  # Unique abbreviation for Barents Sea\n",
    "    elif row['LME'] == 'Beaufort Sea LME':\n",
    "        short_label = 'BeS'  # Unique abbreviation for Beaufort Sea\n",
    "    else:\n",
    "        words = row['LME'].split()  # Split the name into words\n",
    "        short_label = ''.join([word[0] for word in words[:-1]])  # Take the first letter of each word except the last one\n",
    "    # Add the label to the map\n",
    "    ax.text(\n",
    "        row['lon'],\n",
    "        row['lat'],\n",
    "        short_label,  # Use the shortened label\n",
    "        transform=ccrs.PlateCarree(),\n",
    "        fontsize=12,\n",
    "        fontweight='bold',  # Make the text bold\n",
    "        color='black',\n",
    "        ha='center',\n",
    "        va='center',\n",
    "        path_effects=[pe.withStroke(linewidth=1, foreground='white')]\n",
    "    )\n",
    "\n",
    "# Step 7: Manual adjustment for problematic labels\n",
    "for _, row in gdf_lme_pc.iterrows():\n",
    "    if row['LME'] == 'Central Arctic LME':\n",
    "        ax.text(\n",
    "            -179, 89,  # Replace with correct longitude and latitude\n",
    "            'CAO',\n",
    "            transform=ccrs.PlateCarree(),\n",
    "            fontsize=12,\n",
    "            fontweight='bold',\n",
    "            color='black',\n",
    "            ha='center',\n",
    "            va='center',\n",
    "            path_effects=[pe.withStroke(linewidth=1, foreground='white')]\n",
    "        )\n",
    "    elif row['LME'] == 'Chukchi Sea LME':\n",
    "        ax.text(\n",
    "            -174, 69,  # Replace with correct longitude and latitude\n",
    "            'CS',\n",
    "            transform=ccrs.PlateCarree(),\n",
    "            fontsize=12,\n",
    "            fontweight='bold',\n",
    "            color='black',\n",
    "            ha='center',\n",
    "            va='center',\n",
    "            path_effects=[pe.withStroke(linewidth=2, foreground='white')]\n",
    "        )\n",
    "    elif row['LME'] == 'East Bering Sea LME':\n",
    "        ax.text(\n",
    "            -174, 58,  # Replace with correct longitude and latitude\n",
    "            'EBS',\n",
    "            transform=ccrs.PlateCarree(),\n",
    "            fontsize=12,\n",
    "            fontweight='bold',\n",
    "            color='black',\n",
    "            ha='center',\n",
    "            va='center',\n",
    "            path_effects=[pe.withStroke(linewidth=2, foreground='white')]\n",
    "        )\n",
    "    elif row['LME'] == 'Alutian Islands LME':\n",
    "        ax.text(\n",
    "            -179, 52,  # Replace with correct longitude and latitude\n",
    "            'AI',\n",
    "            transform=ccrs.PlateCarree(),\n",
    "            fontsize=12,\n",
    "            fontweight='bold',\n",
    "            color='black',\n",
    "            ha='center',\n",
    "            va='center',\n",
    "            path_effects=[pe.withStroke(linewidth=2, foreground='white')]\n",
    "        )\n",
    "\n",
    "# Plot the station points\n",
    "ax.scatter(coords['lon'].values, coords['lat'].values,\n",
    "           s=1, color='#9DC8D2', alpha=0.6, transform=ccrs.PlateCarree(), label='All stations')\n",
    "\n",
    "\n",
    "plt.savefig(\"Figures/map_stations.png\", dpi=300, bbox_inches=\"tight\", facecolor=\"white\")\n",
    "plt.show()"
   ]
  },
  {
