   "source": [
    "#| fig-pos: \"H\"\n",
    "\n",
    "# Load the Excel file\n",
    "geo_path = 'Final/merged_all_final.parquet'\n",
    "biota_geo_df = pd.read_parquet(geo_path)\n",
    "\n",
    "# Clean column names and handle missing values\n",
    "biota_geo_df.columns = [c.strip() for c in biota_geo_df.columns]  # Strip whitespace from column names\n",
    "geo_col = 'geomorphologicalCategory'\n",
    "accepted_col = 'acceptedAphiaID'\n",
    "rank_col = 'taxonRank'\n",
    "\n",
    "# Ensure required columns exist\n",
    "required_cols = [geo_col, accepted_col, rank_col]\n",
    "missing = [c for c in required_cols if c not in biota_geo_df.columns]\n",
    "if missing:\n",
    "    raise KeyError(f\"Required column(s) missing: {missing}\")\n",
    "\n",
    "# Convert key columns and clean category labels\n",
    "biota_geo_df[accepted_col] = pd.to_numeric(biota_geo_df[accepted_col], errors='coerce')\n",
    "biota_geo_df[geo_col] = biota_geo_df[geo_col].fillna('Outside geomorphological categories')\n",
    "biota_geo_df[geo_col] = biota_geo_df[geo_col].replace('', 'Outside geomorphological categories')\n",
    "biota_geo_df[geo_col] = biota_geo_df[geo_col].astype(str).str.strip()\n",
    "biota_geo_df.loc[biota_geo_df[geo_col].isin(['nan', 'None']), geo_col] = 'Outside geomorphological categories'\n",
    "rank_norm = biota_geo_df[rank_col].astype(str).str.strip().str.upper()\n",
    "\n",
    "# Records split by species vs other ranks per geomorphological category\n",
    "total_records = biota_geo_df.groupby(geo_col, dropna=False).size().reset_index(name='total_records')\n",
    "species_records = (\n",
    "    biota_geo_df.loc[rank_norm.eq('SPECIES')]\n",
    "               .groupby(geo_col, dropna=False)\n",
    "               .size()\n",
    "               .reset_index(name='records_species')\n",
    ")\n",
    "records = pd.merge(total_records, species_records, on=geo_col, how='left').fillna({'records_species': 0})\n",
    "records['records_species'] = records['records_species'].astype(int)\n",
    "records['records_other'] = records['total_records'] - records['records_species']\n",
    "\n",
    "# Unique AphiaID split by any-species appearance within each category\n",
    "flags = (\n",
    "    biota_geo_df.dropna(subset=[accepted_col])\n",
    "               .assign(_is_species=rank_norm.eq('SPECIES'))\n",
    "               .groupby([geo_col, accepted_col], dropna=False)['_is_species']\n",
    "               .any()\n",
    "               .reset_index(name='is_species')\n",
    ")\n",
    "unique_total = (\n",
    "    flags.groupby(geo_col, dropna=False)[accepted_col]\n",
    "         .nunique()\n",
    "         .reset_index(name='unique_taxa')\n",
    ")\n",
    "unique_species = (\n",
    "    flags.loc[flags['is_species']]\n",
    "         .groupby(geo_col, dropna=False)[accepted_col]\n",
    "         .nunique()\n",
    "         .reset_index(name='unique_species')\n",
    ")\n",
    "unique_ids = pd.merge(unique_total, unique_species, on=geo_col, how='left').fillna({'unique_species': 0})\n",
    "unique_ids['unique_species'] = unique_ids['unique_species'].astype(int)\n",
    "unique_ids['unique_other'] = unique_ids['unique_taxa'] - unique_ids['unique_species']\n",
    "\n",
    "# Merge metrics into a single DataFrame\n",
    "summary_df = pd.merge(\n",
    "    records[[geo_col, 'total_records', 'records_species', 'records_other']],\n",
    "    unique_ids[[geo_col, 'unique_taxa', 'unique_species', 'unique_other']],\n",
    "    on=geo_col,\n",
    "    how='outer'\n",
    ").fillna(0)\n",
    "for c in ['total_records', 'records_species', 'records_other', 'unique_taxa', 'unique_species', 'unique_other']:\n",
    "    summary_df[c] = summary_df[c].astype(int)\n",
    "\n",
    "# Sort data so that categories with the highest number of records are lowest on the y-axis\n",
    "summary_df = summary_df.sort_values('total_records', ascending=False)\n",
    "\n",
    "# Define colors for each category\n",
    "category_colors = {\n",
    "    'Abyssal plains': '#C3C3C3',\n",
    "    'Ridges': '#80107B',\n",
    "    'Abyssal mountains and hills': '#7F7F7F',\n",
    "    'Slope': '#BDCEE1',\n",
    "    'Deep shelf': '#403F1B',\n",
    "    'Medium shelf': '#857C2E',\n",
    "    'Shallow shelf': '#BFC558',\n",
    "    'Outside geomorphological categories': 'white'\n",
    "}\n",
    "\n",
    "# Prepare data for plotting\n",
    "categories = summary_df[geo_col].tolist()\n",
    "species_colors = [category_colors.get(cat, 'lightgray') for cat in categories]\n",
    "other_colors = ['white' for _ in categories]\n",
    "edge_colors = [\n",
    "    'gray' if cat == 'Outside geomorphological categories' else category_colors.get(cat, 'lightgray')\n",
    "    for cat in categories\n",
    "]\n",
    "\n",
    "# Create mirrored bar plot\n",
    "fig, (ax_left, ax_right) = plt.subplots(\n",
    "    ncols=2, figsize=(12, 4), gridspec_kw={'width_ratios': [1, 1]}\n",
    ")\n",
    "\n",
    "# Left: records (negative)\n",
    "ax_left.barh(\n",
    "    categories,\n",
    "    -summary_df['records_species'],\n",
    "    color=species_colors,\n",
    "    edgecolor='none',\n",
    "    linewidth=1.0\n",
    " )\n",
    "ax_left.barh(\n",
    "    categories,\n",
    "    -summary_df['records_other'],\n",
    "    left=-summary_df['records_species'],\n",
    "    color=other_colors,\n",
    "    edgecolor=edge_colors,\n",
    "    hatch='///',\n",
    "    linewidth=1.2\n",
    " )\n",
    "# Outline the full stacked bars\n",
    "ax_left.barh(\n",
    "    categories,\n",
    "    -summary_df['total_records'],\n",
    "    color='none',\n",
    "    edgecolor=edge_colors,\n",
    "    linewidth=1.2\n",
    " )\n",
    "\n",
    "# Right: unique taxa (positive)\n",
    "ax_right.barh(\n",
    "    categories,\n",
    "    summary_df['unique_species'],\n",
    "    color=species_colors,\n",
    "    edgecolor='none',\n",
    "    linewidth=1.0\n",
    " )\n",
    "ax_right.barh(\n",
    "    categories,\n",
    "    summary_df['unique_other'],\n",
    "    left=summary_df['unique_species'],\n",
    "    color=other_colors,\n",
    "    edgecolor=edge_colors,\n",
    "    hatch='///',\n",
    "    linewidth=1.2\n",
    " )\n",
    "# Outline the full stacked bars\n",
    "ax_right.barh(\n",
    "    categories,\n",
    "    summary_df['unique_taxa'],\n",
    "    color='none',\n",
    "    edgecolor=edge_colors,\n",
    "    linewidth=1.2\n",
    " )\n",
    "\n",
    "# Format axes\n",
    "ax_left.set_xlabel('Number of records', fontsize=14)\n",
    "ax_left.set_xlim(-summary_df['total_records'].max() * 1.1, 0)\n",
    "ax_left.spines['right'].set_visible(False)\n",
    "ax_left.spines['top'].set_visible(False)\n",
    "ax_left.xaxis.set_major_formatter(FuncFormatter(lambda x, pos: f'{int(abs(x)):,}'))  # Thousands separator\n",
    "ax_left.xaxis.set_major_locator(MaxNLocator(nbins=7, prune='both'))\n",
    "\n",
    "ax_right.set_xlabel('Number of unique taxa', fontsize=14)\n",
    "ax_right.set_xlim(0, summary_df['unique_taxa'].max() * 1.1)\n",
    "ax_right.xaxis.set_major_formatter(FuncFormatter(lambda x, pos: f'{int(abs(x)):,}'))  # Thousands separator\n",
    "ax_right.spines['left'].set_visible(False)\n",
    "ax_right.spines['top'].set_visible(False)\n",
    "\n",
    "# Remove y-ticks and labels\n",
    "ax_left.set_yticks([])\n",
    "ax_left.set_yticklabels([])\n",
    "ax_right.set_yticks([])\n",
    "ax_right.set_yticklabels([])\n",
    "ax_left.text(0.01, 0.99, 'a)', transform=ax_left.transAxes, ha='left', va='top', fontsize=14, fontweight='bold', zorder=10)\n",
    "\n",
    "# Add style legend for taxonomic level (top) with text outside sample boxes\n",
    "box_w, box_h = 0.05, 0.035\n",
    "y_box = 0.965\n",
    "x_species = 0.3\n",
    "x_other = 0.5\n",
    "\n",
    "species_box = plt.Rectangle(\n",
    "    (x_species, y_box - box_h), box_w, box_h,\n",
    "    transform=fig.transFigure,\n",
    "    facecolor='#7F7F7F',\n",
    "    edgecolor='#7F7F7F',\n",
    "    linewidth=0.8,\n",
    "    clip_on=False\n",
    ")\n",
    "other_box = plt.Rectangle(\n",
    "    (x_other, y_box - box_h), box_w, box_h,\n",
    "    transform=fig.transFigure,\n",
    "    facecolor='white',\n",
    "    edgecolor='#7F7F7F',\n",
    "    hatch='///',\n",
    "    linewidth=0.8,\n",
    "    clip_on=False\n",
    ")\n",
    "fig.add_artist(species_box)\n",
    "fig.add_artist(other_box)\n",
    "\n",
    "fig.text(\n",
    "    x_species + box_w + 0.01, y_box - box_h / 2, 'Species level',\n",
    "    ha='left', va='center', fontsize=14, color='black'\n",
    ")\n",
    "fig.text(\n",
    "    x_other + box_w + 0.01, y_box - box_h / 2, 'Other taxonomic levels',\n",
    "    ha='left', va='center', fontsize=14, color='black'\n",
    ")\n",
    "\n",
    "# Keep category legend below the plot\n",
    "legend_categories = categories[::-1]\n",
    "legend_labels = [f\"{cat}\" for cat in legend_categories]\n",
    "legend_patches = [\n",
    "    Patch(\n",
    "        facecolor=category_colors.get(cat, 'lightgray'),\n",
    "        edgecolor='gray' if cat == 'Outside geomorphological categories' else 'none',\n",
    "        linewidth=1.5\n",
    "    )\n",
    "    for cat in legend_categories\n",
    "]\n",
    "fig.legend(\n",
    "    legend_patches,\n",
    "    legend_labels,\n",
    "    loc='lower center',\n",
    "    bbox_to_anchor=(0.5, -0.20),\n",
    "    ncol=4,\n",
    "    fontsize=14,\n",
    "    frameon=False,\n",
    "    markerscale=3\n",
    ")\n",
    "\n",
    "# Adjust layout and save the plot\n",
    "plt.tight_layout()\n",
    "plt.subplots_adjust(top=0.86, wspace=0.02)\n",
    "plt.savefig('Figures/geo_records_taxa.png', dpi=220, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
